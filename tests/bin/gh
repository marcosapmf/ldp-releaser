#!/usr/bin/env python3
"""Fake gh for the tests, working on a local bare repository as "GitHub".

Pull requests are approved on their second look and pass the Prisma check on
the third; `gh pr merge` then merges them (refused before the approval). The tag suffix
in the body changes that:
    ...ccccccc  never approved, closed on the third look
    ...fffffff  only approved once the file merge-now exists in FAKE_GH_STATE
    ...9999999  the Prisma check fails
With FAKE_GH_HUMAN_MERGES set, approved pull requests are merged on the
third look, as a person would, without `gh pr merge`.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

ORIGIN = os.environ["FAKE_ORIGIN"]
STATE_DIR = Path(os.environ["FAKE_GH_STATE"])
STATE_FILE = STATE_DIR / "state.json"


def git(*args):
    return subprocess.run(
        ["git", "--git-dir", ORIGIN, *args], capture_output=True, check=True,
        text=True).stdout.strip()


def option(name):
    return sys.argv[sys.argv.index(name) + 1]


def main():
    state = {"next": 1, "pulls": {}, "tags": {}}

    if STATE_FILE.exists():
        state = json.loads(STATE_FILE.read_text())

    command = sys.argv[1:3]
    code = 0

    if command == ["pr", "create"]:
        number = state["next"]
        state["next"] += 1
        state["pulls"][str(number)] = {
            "base": option("--base"),
            "body": option("--body"),
            "head": option("--head"),
            "title": option("--title"),
            "views": 0,
        }

        print(f"https://github.example/pull/{number}")
    elif command == ["pr", "list"]:
        key = option("--search").split()[0]
        base = option("--base")

        print(json.dumps([
            {
                "headRefName": pull["head"],
                "title": pull["title"],
                "url": f"https://github.example/pull/{number}",
            }
            for number, pull in state["pulls"].items()
            if pull["base"] == base and key in pull["title"] and
            not pull.get("merged") and not pull.get("closed")
        ]))
    elif command == ["pr", "merge"]:
        number = sys.argv[3].rsplit("/", 1)[1]
        pull = state["pulls"][number]

        if not approved(pull):
            print("GraphQL: Pull request is not mergeable: approval required", file=sys.stderr)

            code = 1
        else:
            merge(state, number, "merge" if "--merge" in sys.argv else "squash")
            state.setdefault("merges", []).append({"number": number, "method": pull["mergedWith"]})
    elif command == ["pr", "view"]:
        number = sys.argv[3].rsplit("/", 1)[1]
        print(json.dumps(view(state, number)))
    elif sys.argv[1] == "api":
        code = api(state)
    else:
        sys.exit(f"fake gh: unsupported {sys.argv[1:]}")

    STATE_FILE.write_text(json.dumps(state))

    sys.exit(code)


def api(state):
    path = next(argument for argument in sys.argv[2:] if argument.startswith("repos/"))
    parts = path.split("/")
    repository = f"{parts[1]}/{parts[2]}"

    if len(parts) == 3:
        print("true")

        return 0

    if "--method" in sys.argv:
        fields = dict(
            argument.split("=", 1) for argument in sys.argv
            if argument.startswith(("ref=", "sha=")))
        tag = fields["ref"].removeprefix("refs/tags/")

        if f"{repository}:{tag}" in state["tags"]:
            print("gh: Reference already exists (HTTP 422)", file=sys.stderr)

            return 1

        state["tags"][f"{repository}:{tag}"] = fields["sha"]

        print(fields["ref"])

        return 0

    tag = parts[-1]

    if f"{repository}:{tag}" not in state["tags"]:
        print('{"message":"Not Found"}')
        print("gh: Not Found (HTTP 404)", file=sys.stderr)

        return 1

    print(json.dumps({"ref": f"refs/tags/{tag}"}))

    return 0


def merge(state, number, method):
    pull = state["pulls"][number]
    head = git("rev-parse", f"refs/heads/{pull['head']}")
    base = git("rev-parse", f"refs/heads/{pull['base']}")
    tree = git("rev-parse", f"{head}^{{tree}}")

    if method == "merge":
        merged = git("commit-tree", tree, "-p", base, "-p", head, "-m", f"Merge #{number}")
    else:
        merged = git("commit-tree", tree, "-p", base, "-m", f"{pull['title']} (#{number})")

    git("update-ref", f"refs/heads/{pull['base']}", merged)
    git("update-ref", "-d", f"refs/heads/{pull['head']}")

    pull["headSha"] = head
    pull["merged"] = merged
    pull["mergedWith"] = method


def approved(pull):

    # A held pull request (fffffff) is only approved once merge-now exists;
    # one that will be closed (ccccccc) never is.

    if "ccccccc" in pull["body"]:
        return False

    if "fffffff" in pull["body"] and not (STATE_DIR / "merge-now").exists():
        return False

    return pull["views"] >= 2


def view(state, number):
    pull = state["pulls"][number]
    pull["views"] += 1

    # The Prisma scan finishes one look after the approval, so a pull
    # request is seen approved but still waiting for it. It passes unless
    # the tag suffix in the body is 9999999.

    prisma = {"conclusion": "", "name": "Prisma Cloud / Code analysis", "status": "IN_PROGRESS"}

    if pull["views"] >= 3:
        prisma["status"] = "COMPLETED"
        prisma["conclusion"] = "FAILURE" if "9999999" in pull["body"] else "SUCCESS"

    result = {
        "commits": [],
        "mergeCommit": None,
        "number": int(number),
        "reviewDecision": "APPROVED" if approved(pull) else "REVIEW_REQUIRED",
        "state": "OPEN",
        "statusCheckRollup": [
            {"conclusion": "SUCCESS", "name": "diff", "status": "COMPLETED"}, prisma,
        ],
    }

    if not pull.get("merged") and "ccccccc" in pull["body"] and pull["views"] >= 3:
        pull["closed"] = True

    # Without merge settings in the team file a person merges: the fake
    # does it on the third look when FAKE_GH_HUMAN_MERGES is set.

    if (not pull.get("merged") and not pull.get("closed") and approved(pull) and
            pull["views"] >= 3 and os.environ.get("FAKE_GH_HUMAN_MERGES")):

        merge(state, number, "squash")

    if pull.get("merged"):
        result.update(
            commits=[{"oid": pull["headSha"]}], mergeCommit={"oid": pull["merged"]},
            state="MERGED")
    elif pull.get("closed"):
        result["state"] = "CLOSED"

    return result


if __name__ == "__main__":
    main()
