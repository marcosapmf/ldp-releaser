#!/usr/bin/env python3
"""Fake gcloud for the tests: keeps configurations in FAKE_GCLOUD_STATE and
reports FAKE_GCLOUD_ACCOUNT as the active login."""

import json
import os
import sys
from pathlib import Path

STATE = Path(os.environ["FAKE_GCLOUD_STATE"])
EXPIRED = STATE.with_name("gcloud-expired")


def expired():
    return bool(os.environ.get("FAKE_GCLOUD_EXPIRED")) or EXPIRED.exists()


def main():
    state = {"active": "default", "configurations": {}}

    if STATE.exists():
        state = json.loads(STATE.read_text())

    arguments = sys.argv[1:]
    code = 0

    if arguments[:2] == ["auth", "login"]:

        # Like gcloud without a browser: print the sign-in link, then wait
        # for the verification code.

        print("Go to the following link in your browser, and complete the sign-in prompts:")
        print()
        print("    https://accounts.example/o/oauth2/auth?client=fake")
        print()
        print("Once finished, enter the verification code provided in your browser: ", flush=True)

        if sys.stdin.readline().strip() == "good-code":
            EXPIRED.unlink(missing_ok=True)

            print("You are now logged in.")
        else:
            print("ERROR: invalid verification code", file=sys.stderr)

            code = 1
    elif arguments[:4] == ["composer", "environments", "storage", "dags"]:
        def option(name):
            return arguments[arguments.index(name) + 1]

        if expired():
            print("ERROR: Reauthentication failed.", file=sys.stderr)

            code = 1
        else:
            state.setdefault("imports", []).append({
                "environment": option("--environment"),
                "location": option("--location"),
                "project": option("--project"),
                "source": option("--source"),
            })

            print(f"Imported {option('--source')}")
    elif arguments[:2] == ["auth", "print-access-token"]:
        if expired():
            print("ERROR: Reauthentication failed. cannot prompt during non-interactive execution.", file=sys.stderr)

            code = 1
        else:
            print("fake-token")
    elif arguments[:2] == ["auth", "list"]:
        print(os.environ.get("FAKE_GCLOUD_ACCOUNT", ""))
    elif arguments[:3] == ["config", "configurations", "describe"]:
        configuration = state["configurations"].get(arguments[3])

        if configuration is None:
            print(f"ERROR: Cannot find a configuration named [{arguments[3]}].", file=sys.stderr)

            code = 1
        else:
            print(json.dumps({"name": arguments[3], "properties": configuration}))
    elif arguments[:3] == ["config", "configurations", "create"]:
        state["configurations"][arguments[3]] = {}

        if "--no-activate" not in arguments:
            state["active"] = arguments[3]
    elif arguments[:3] == ["config", "configurations", "delete"]:
        for name in arguments[3:]:
            if not name.startswith("--"):
                state["configurations"].pop(name, None)
    elif arguments[:2] == ["config", "set"] and arguments[3] in os.environ.get(
            "FAKE_GCLOUD_FORBIDDEN_PROJECTS", "").split(","):

        print(f"ERROR: you cannot access project [{arguments[3]}]", file=sys.stderr)

        code = 1
    elif arguments[:2] == ["config", "set"]:
        name = next(
            argument.split("=", 1)[1] for argument in arguments
            if argument.startswith("--configuration="))
        section, _, key = arguments[2].rpartition("/")

        state["configurations"][name].setdefault(section or "core", {})[key] = arguments[3]
    else:
        sys.exit(f"fake gcloud: unsupported {arguments}")

    STATE.write_text(json.dumps(state))

    sys.exit(code)


if __name__ == "__main__":
    main()
