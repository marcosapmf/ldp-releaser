#!/usr/bin/env python3
"""Fake 1Password CLI for the tests. `op document get <item> [--vault <vault>]`
prints the file FAKE_OP_STATE/<vault>/<item>, `op item get` gives its
modification time as updated_at, and every call is logged to
FAKE_OP_STATE/calls."""

import json
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

STATE_DIR = Path(os.environ.get("FAKE_OP_STATE", "/nonexistent"))

arguments = sys.argv[1:]

if STATE_DIR.is_dir():
    with (STATE_DIR / "calls").open("a") as file:
        file.write(" ".join(arguments) + "\n")

if arguments[:2] not in (["document", "get"], ["item", "get"]) or len(arguments) < 3:
    sys.exit(f"[ERROR] unsupported fake op command: {arguments}")

vault = "default"

if "--vault" in arguments:
    vault = arguments[arguments.index("--vault") + 1]

document = STATE_DIR / vault / arguments[2]

if not document.is_file():
    sys.exit(f'[ERROR] "{arguments[2]}" isn\'t an item in the "{vault}" vault')

if arguments[0] == "item":
    updated_at = datetime.fromtimestamp(document.stat().st_mtime, timezone.utc)

    print(json.dumps({"updated_at": updated_at.isoformat().replace("+00:00", "Z")}))
else:
    sys.stdout.write(document.read_text())
